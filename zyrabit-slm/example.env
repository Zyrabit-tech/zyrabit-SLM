# Zyrabit Brain API - Environment Variables
# Copy to .env and adjust values:
#   cp example.env .env

# --- Required: API Authentication ---
# Each client gets its own named Bearer token for audit logging.
# The web-ui sends 'zyrabit-local-token' by default.
ZYRABIT_API_KEY_WEB=zyrabit-local-token
ZYRABIT_API_KEY_MCP=zyrabit-mcp-token

# --- Required: Core Stack & Inference Configuration ---
# Inference Provider Options:
# 1. ollama          → Docker container (default: http://zyrabit-engine:11434)
# 2. ollama_host     → Native Ollama process on Host/Mac Metal (http://host.docker.internal:11434)
# 3. vllm            → vLLM Engine or llama.cpp / LM Studio server with OpenAI-compatible API
#                       (e.g., http://host.docker.internal:8000/v1/chat/completions)
# 4. gemini          → Google Gemini Cloud API (requires GEMINI_API_KEY)
INFERENCE_PROVIDER=ollama

# Inference Server Endpoint (SLM_URL)
# - Default Docker Ollama: http://zyrabit-engine:11434
# - Mac Apple Silicon (Metal) / Host Ollama: http://host.docker.internal:11434
# - Tenstorrent Bridge: http://zyrabit-tt-bridge:8000
# - vLLM Server: http://localhost:8000 (or http://host.docker.internal:8000)
# - llama.cpp (server mode): http://host.docker.internal:8080 (or http://localhost:8080)
SLM_URL=http://zyrabit-engine:11434

# Vector Database Engine (chroma | pgvector)
VECTOR_DB_TYPE=chroma

# Vector Database URL (ChromaDB / PostgreSQL)
DB_URL=http://zyrabit-db:8000

# Default Language Model
# - For Ollama: qwen2.5:7b, mistral, llama3.2:3b, phi3, etc.
# - For vLLM / llama.cpp: The model identifier registered in your server (e.g. meta-llama/Llama-3.2-3B-Instruct)
MODEL_NAME=qwen2.5:7b

# Maximum inference timeout in seconds
INFERENCE_TIMEOUT_SECONDS=120

# Required ONLY if INFERENCE_PROVIDER=gemini
# GEMINI_API_KEY=your_gemini_api_key_here

# --- Required: Observability (Traefik Basic Auth) ---
# Las variables contienen un HASH, no la contraseña en texto plano.
# Para acceder a /prometheus y /grafana: usuario=admin, contraseña=changeme
# No hace falta generar nuevas; las de abajo funcionan. Para cambiar: htpasswd -nbB admin 'tu-password'
# IMPORTANTE: Usar comillas simples para que Docker Compose no interprete los $ del hash bcrypt como variables.
PROMETHEUS_BASIC_AUTH='admin:$2y$05$LoszVeOlLfBI4CdVxATZZ.9yHl10rudfmIsO.wAeSCOjpgCccVoiC'
GRAFANA_BASIC_AUTH='admin:$2y$05$LoszVeOlLfBI4CdVxATZZ.9yHl10rudfmIsO.wAeSCOjpgCccVoiC'

# --- Optional: RAG / Embeddings ---
EMBEDDING_MODEL=mxbai-embed-large
RAG_COLLECTION=zyrabit_knowledge
CHUNK_SIZE=1000
CHUNK_OVERLAP=200

# --- Optional: n8n Integration ---
# Para el workflow de ejemplo: usa zyrabit-service-token (o cambia en n8n_zyrabit_webhook_workflow.json)
N8N_SERVICE_TOKEN=zyrabit-service-token
N8N_WEBHOOK_SIGNING_SECRET=zyrabit-webhook-secret
N8N_REQUIRE_SIGNATURE=false