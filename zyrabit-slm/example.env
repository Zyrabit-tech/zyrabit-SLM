# Zyrabit Brain API - Environment Variables
# Copy to .env and adjust values:
#   cp example.env .env

# --- Required: API Authentication ---
# Each client gets its own named Bearer token for audit logging.
# Generate local values with: openssl rand -hex 32
# The UI receives ZYRABIT_API_KEY_WEB only at container startup; it is never committed.
ZYRABIT_API_KEY_WEB=replace-with-a-random-local-token
ZYRABIT_API_KEY_MCP=replace-with-a-separate-random-token
ZYRABIT_LOCAL_PORT=8080
ZYRABIT_BIND_IP=127.0.0.1

# --- Required: Core Stack ---
# Inference provider options:
# - ollama (default)
# - ollama_host
# - ollama_docker
# - cuda (NVIDIA host; same Ollama engine as ollama)
# - openai_compatible
INFERENCE_PROVIDER=ollama
OLLAMA_VERSION=0.5.12
SLM_URL=http://zyrabit-engine:11434
# Embeddings are independent from generation. When using Docker mode, this points
# to zyrabit-engine. When using host Ollama, point to http://host.docker.internal:11434.
EMBEDDING_URL=http://zyrabit-engine:11434
DB_URL=http://zyrabit-db:8000
MODEL_NAME=qwen2.5:7b
INFERENCE_TIMEOUT_SECONDS=120

# For openai_compatible providers
# INFERENCE_BASE_URL=http://localhost:8000/v1/chat/completions
# INFERENCE_API_KEY=

# Optional Traefik dashboard. Leave unset. Setting this to true also
# requires TRAEFIK_DASHBOARD_AUTH=user:htpasswd_hash. The dashboard then
# listens on 127.0.0.1:8082. The default compose file does not publish it.
# ZYRABIT_TRAEFIK_DASHBOARD=false
# TRAEFIK_DASHBOARD_AUTH=

# --- Required: Observability (Traefik Basic Auth) ---
# Variables contain a HASH, not plaintext password.
# To access /prometheus and /grafana: user=admin, password=changeme
# No need to generate new ones; the defaults below work. To change: htpasswd -nbB admin 'your-password'
# IMPORTANT: Use single quotes so Docker Compose does not interpret bcrypt hash '$' as variables.
PROMETHEUS_BASIC_AUTH='admin:$2y$05$LoszVeOlLfBI4CdVxATZZ.9yHl10rudfmIsO.wAeSCOjpgCccVoiC'
GRAFANA_BASIC_AUTH='admin:$2y$05$LoszVeOlLfBI4CdVxATZZ.9yHl10rudfmIsO.wAeSCOjpgCccVoiC'

# --- Optional: RAG / Embeddings ---
EMBEDDING_MODEL=mxbai-embed-large
RAG_COLLECTION=zyrabit_knowledge
CHUNK_SIZE=1000
CHUNK_OVERLAP=200

# --- Zyrabit Node document runtime ---
NODE_DATA_DIR=/app/db_data/node
NODE_ENABLE_OCR=false
NODE_RETRIEVAL_MODE=hybrid
ENABLE_LEGACY_EXTENSIONS=false
# local-minimal | local-balanced | local-performance
NODE_RUNTIME_PROFILE=local-minimal

# --- Optional: n8n Integration ---
# Para el workflow de ejemplo: usa zyrabit-service-token (o cambia en n8n_zyrabit_webhook_workflow.json)
N8N_SERVICE_TOKEN=zyrabit-service-token
N8N_WEBHOOK_SIGNING_SECRET=zyrabit-webhook-secret
N8N_REQUIRE_SIGNATURE=false

# --- Optional: PostgreSQL (Production database - activated with --production flag or profile 'db') ---
# When enabled, replaces SQLite WAL with persistent relational storage for users, API keys, and audit logs.
# Activate with: ./zyra.sh start --profile db
POSTGRES_DB=zyrabit_db
POSTGRES_USER=zyrabit
POSTGRES_PASSWORD=change_me_in_production
DATABASE_URL=postgresql://zyrabit:change_me_in_production@zyrabit-postgres:5432/zyrabit_db

# --- OpenTelemetry & Observability ---
OTEL_ENABLED=true
OTEL_SERVICE_NAME=zyrabit-slm-api
OTEL_EXPORTER_PROMETHEUS_PORT=9090

